// Prisma schema for SmartDesk Coworking - User model
// Datasource and generator
// Note: Ensure DATABASE_URL is provided in environment (e.g., postgres connection string)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Account status for users
enum AccountStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DISABLED
}

// Coworking closure types
enum ClosureType {
  SINGLE
  WEEKLY
  ANNUAL
  @@map("closure_type")
}

// Booking lifecycle state (computed/managed by backend)
enum BookingState {
  PASSATA
  ATTIVA
  CANCELLATA
  CANCELLATA_DA_UTENTE
  @@map("booking_state")
}

/// User model
/// IMPORTANT: Do not log sensitive fields (passwordHash, salt, verificationToken)
model User {
  id                     String         @id @default(uuid()) @db.Uuid
  email                  String         @unique @db.VarChar(320)
  passwordHash           String         @map("password_hash") @db.VarChar(255)
  salt                   String?        @map("salt") @db.VarChar(255)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  status                 AccountStatus  @default(ACTIVE) @map("status")
  verificationToken      String?        @map("verification_token") @db.VarChar(255)
  verificationExpiresAt  DateTime?      @map("verification_expires_at")

  // relation
  refreshTokens          RefreshToken[]
  bookings               Booking[]

  @@map("users")
  @@index([createdAt], map: "idx_users_created_at")
  @@index([verificationToken], map: "idx_users_verification_token")
}

/// RefreshToken model for session/refresh management
model RefreshToken {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @db.Uuid
  tokenHash            String    @db.VarChar(255)
  issuedAt             DateTime  @map("issued_at")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  revokedReason        String?   @map("revoked_reason") @db.VarChar(255)
  userAgent            String?   @map("user_agent") @db.VarChar(255)
  ipAddress            String?   @map("ip_address") @db.VarChar(64)
  familyId             String    @map("family_id") @db.Uuid
  replacementTokenId   String?   @map("replacement_token_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  revokedBy            String?   @map("revoked_by") @db.VarChar(255)

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([userId], map: "idx_refresh_tokens_user_id")
  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@index([tokenHash], map: "idx_refresh_tokens_token_hash")
  @@index([familyId], map: "idx_refresh_tokens_family_id")
}

// Booking status enum
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Booking model for desk reservations
model Booking {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @db.Uuid
  deskId     String        @db.Uuid
  date       DateTime
  timeSlot   String?       @map("time_slot") @db.VarChar(50)
  status     BookingStatus @default(CONFIRMED)
  state      BookingState  @default(ATTIVA) @map("state")
  startAt    DateTime?     @map("start_at")
  endAt      DateTime?     @map("end_at")
  canceledAt DateTime?     @map("canceled_at")
  cancellationReason String? @map("cancellation_reason") @db.VarChar(255)
  canceledBy String?       @map("canceled_by") @db.VarChar(50)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bookings")
  @@unique([deskId, date, timeSlot], map: "uq_booking_unique_active")
  @@index([userId], map: "idx_bookings_user_id")
  @@index([date], map: "idx_bookings_date")
  @@index([state], map: "idx_bookings_state")
  @@index([startAt], map: "idx_bookings_start_at")
  @@index([canceledAt], map: "idx_bookings_canceled_at")
}

// Coworking closures configuration
model CoworkingClosure {
  id        String   @id @default(uuid()) @db.Uuid
  type      ClosureType
  date      DateTime? // for SINGLE
  weekday   Int?      @db.SmallInt // 0..6 for WEEKLY
  month     Int?      @db.SmallInt // 1..12 for ANNUAL
  monthDay  Int?      @map("month_day") @db.SmallInt // 1..31 for ANNUAL
  reason    String?   @db.VarChar(255)
  active    Boolean   @default(true)
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("coworking_closures")
  @@index([active], map: "idx_cw_closures_active")
}
