// Prisma schema for SmartDesk Coworking - User model
// Database: PostgreSQL
// Notes:
// - Uses citext for case-insensitive unique email
// - Stores password hash (no plain password)
// - Optional salt column (most libs like bcrypt/argon2 embed salt in hash)
// - Account status as enum with default ACTIVE
// - Optional email verification support (token + expiration)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

// Stato prenotazione: PASSATA, ATTIVA, CANCELLATA
enum BookingState {
  PASSATA
  ATTIVA
  CANCELLATA
  // Estensioni per audit: distinguere chi ha cancellato
  CANCELLATA_DA_UTENTE
  CANCELLATA_DA_ADMIN
}

// Origine della cancellazione (audit)
enum CancellationSource {
  USER
  ADMIN
  SYSTEM
}

model User {
  id                    String      @id @default(uuid()) @db.Uuid
  email                 String      @unique @db.Citext
  passwordHash          String      @map("password_hash") @db.VarChar(255)
  salt                  String?     @db.VarChar(255)
  accountStatus         UserStatus  @map("account_status") @default(ACTIVE)
  verificationToken     String?     @map("verification_token") @unique @db.VarChar(255)
  verificationExpiresAt DateTime?   @map("verification_expires_at") @db.Timestamptz(6)
  createdAt             DateTime    @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime    @map("updated_at") @updatedAt @db.Timestamptz(6)

  // Profile fields
  firstName             String?     @map("first_name") @db.VarChar(100)
  lastName              String?     @map("last_name") @db.VarChar(100)
  avatarUrl             String?     @map("avatar_url") @db.VarChar(2048)
  avatarId              String?     @map("avatar_id") @db.VarChar(255)

  // Relations
  refreshTokens         RefreshToken[]
  bookings              Booking[]

  @@map("users")
  @@index([createdAt])
}

// Prenotazioni giornaliere delle postazioni
model Booking {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deskId      String       @map("desk_id") @db.VarChar(64)
  date        DateTime     @db.Date
  // Orario di inizio utilizzo prenotazione; opzionale per compatibilità con data-only.
  startAt     DateTime?    @map("start_at") @db.Timestamptz(6)
  // Orario di fine utilizzo prenotazione; opzionale e futuro.
  endAt       DateTime?    @map("end_at") @db.Timestamptz(6)
  status      BookingState @map("stato") @default(ATTIVA)
  cancelledAt DateTime?    @map("cancelled_at") @db.Timestamptz(6)
  // Audit: chi ha effettuato la cancellazione e dettagli opzionali
  cancelledByUserId String?            @map("cancelled_by_user_id") @db.Uuid
  cancelledBy       User?              @relation("BookingCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancellationSource CancellationSource? @map("cancellation_source")
  cancellationReason String?           @map("cancellation_reason") @db.VarChar(255)

  createdAt   DateTime     @map("created_at") @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @map("updated_at") @updatedAt @db.Timestamptz(6)

  @@map("bookings")
  // Nota: l'unico vincolo reale a DB è parziale (esclude cancellate). Prisma non supporta partial unique: mantenere coerenza lato migrazioni SQL.
  @@unique([deskId, date])
  @@index([userId, date])
  @@index([userId, status, date])
  @@index([cancelledAt])
  @@index([cancellationSource])
  @@index([userId, cancelledAt])
}

// Refresh tokens/session tracking for JWT auth
model RefreshToken {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash            String   @map("token_hash") @db.VarChar(255)
  ipAddress            String?  @map("ip_address") @db.VarChar(45)
  userAgent            String?  @map("user_agent") @db.VarChar(255)
  isRevoked            Boolean  @map("is_revoked") @default(false)
  replacedByTokenHash  String?  @map("replaced_by_token_hash") @db.VarChar(255)
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt            DateTime @map("created_at") @default(now()) @db.Timestamptz(6)
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@map("refresh_tokens")
  @@unique([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@index([userId, isRevoked])
}
