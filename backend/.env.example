# Backend SmartDesk env example
PORT=3000
CORS_ORIGIN=http://localhost:5173

# JWT configuration
# Algorithm can be HS256 (default) or RS256
JWT_ALG=HS256

# For HS256 use a strong shared secret
JWT_SECRET=replace_with_strong_secret

# For RS256 provide PEM-encoded keys (use \n for newlines)
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# Token lifetimes
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7
