# Server
PORT=3000
# Comma-separated list of allowed origins for CORS (e.g. http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# JWT config
# Algorithm: HS256 (default) or RS256
JWT_ALG=HS256

# Access token
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_IN=30m

# Refresh token (fallback to JWT_SECRET if not provided for HS256)
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_EXPIRES_IN=7d

# RS256 keys (uncomment if using RS256)
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# JWT_REFRESH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# JWT_REFRESH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
